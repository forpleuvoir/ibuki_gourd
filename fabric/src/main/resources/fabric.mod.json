{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "email": "695801070@qq.com",
    "homepage": "https://modrinth.com/mod/ibukigourd",
    "sources": "https://github.com/forpleuvoir/ibuki_gourd",
    "issues": "https://github.com/forpleuvoir/ibuki_gourd/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "accessWidener": "${mod_id}.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "moe.forpleuvoir.ibukigourd.FabricIbukiGourd"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "moe.forpleuvoir.ibukigourd.FabricIbukiGourdClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "moe.forpleuvoir.ibukigourd.compat.ModMenuImpl"
      }
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "suggests": {
    "another-mod": "modmenu"
  },
  "custom": {
    "ibukigourd": {
      "package": [
        "moe.forpleuvoir.ibukigourd"
      ]
    },
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  }
}
